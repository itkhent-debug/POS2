                      "parameters":  {
                                         "jsCode":  "const rows = $input.all().map(i =\u003e i.json).filter(r =\u003e r.name);\nconst items = rows.map(r =\u003e ({\n  name: r.name,\n  category: r.category,\n  quantity: Number(r.quantity) || 0,\n  unit: r.unit,\n  lowStockThreshold: Number(r.low_stock_threshold) || 0,\n  updatedAt: r.updated_at\n}));\nreturn [{ json: { success: true, count: items.length, items } }];"
