                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "=INSERT INTO inventory (name, category, quantity, unit, low_stock_threshold) VALUES (\u0027{{$json.Name.replace(/\u0027/g, \"\u0027\u0027\")}}\u0027, \u0027{{$json.Category.replace(/\u0027/g, \"\u0027\u0027\")}}\u0027, {{$json.QuantityDelta}}, \u0027{{$json.Unit}}\u0027, {{$json.LowStockThreshold}}) ON DUPLICATE KEY UPDATE quantity = quantity + {{$json.QuantityDelta}}, category = \u0027{{$json.Category.replace(/\u0027/g, \"\u0027\u0027\")}}\u0027, unit = \u0027{{$json.Unit}}\u0027, low_stock_threshold = {{$json.LowStockThreshold}}",
