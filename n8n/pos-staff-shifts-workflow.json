                  {
                      "parameters":  {
                                         "jsCode":  "const rows = $input.all().map(i =\u003e i.json).filter(r =\u003e r.id);\nconst shifts = rows.map(r =\u003e ({\n  id: r.id,\n  staffName: r.staff_name,\n  dayIn: r.day_in,\n  dateIn: r.date_in,\n  timeIn: r.time_in,\n  dayOut: r.day_out,\n  dateOut: r.date_out,\n  timeOut: r.time_out,\n  status: r.status,\n  orderCount: Number(r.order_count) || 0,\n  totalSales: Number(r.total_sales) || 0,\n  totalProfit: Number(r.total_profit) || 0\n}));\nreturn [{ json: { success: true, count: shifts.length, shifts } }];"
                                     },
