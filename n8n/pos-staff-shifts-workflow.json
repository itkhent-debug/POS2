                      "parameters":  {
                                         "jsCode":  "const body = $input.first().json.body ?? $input.first().json;\nconst now = $now.setZone(\u0027Asia/Manila\u0027);\nreturn [{\n  json: {\n    StaffName: body.staffName,\n    Day: now.toFormat(\u0027cccc\u0027),\n    Date: now.toFormat(\u0027yyyy-MM-dd\u0027),\n    Time: now.toFormat(\u0027hh:mm a\u0027),\n    Ts: now.toUTC().toFormat(\u0027yyyy-MM-dd HH:mm:ss\u0027)\n  }\n}];"
