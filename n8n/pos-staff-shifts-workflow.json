                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "SELECT s.id, s.staff_name, s.day_in, s.date_in, s.time_in, s.day_out, s.date_out, s.time_out, s.status, COALESCE((SELECT COUNT(*) FROM orders o WHERE o.staff = s.staff_name AND o.created_at \u003e= s.time_in_ts AND o.created_at \u003c= COALESCE(s.time_out_ts, NOW())), 0) AS order_count, COALESCE((SELECT SUM(o.total) FROM orders o WHERE o.staff = s.staff_name AND o.created_at \u003e= s.time_in_ts AND o.created_at \u003c= COALESCE(s.time_out_ts, NOW())), 0) AS total_sales, COALESCE((SELECT SUM(o.profit) FROM orders o WHERE o.staff = s.staff_name AND o.created_at \u003e= s.time_in_ts AND o.created_at \u003c= COALESCE(s.time_out_ts, NOW())), 0) AS total_profit FROM shifts s ORDER BY s.id DESC",
                                         "options":  {

                                                     }
                                     },
