{
  "name": "POS Auth Sessions",
  "nodes": [
    {
      "parameters": {
        "content": "## Setup\n1. Sa 2 Redis node dito, i-click Credential dropdown → Create New:\n   Host: mist-turn-trusting-68944.db.redis.io\n   Port: 13743\n   Password: yWSgSEb6KsetFMHhBz4B9gHJWNj9FoI3\n   User: default\n   SSL/TLS: OFF (huwag i-check)\n2. Activate.\n\nAudit-log lang ito — HINDI ito ang gate ng login. Kahit magkaproblema ang Redis, gagana pa rin ang normal na login sa POS/Dashboard.",
        "height": 260,
        "width": 380
      },
      "id": "note-node",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-500, -100]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pos-session-log",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "*" }
      },
      "id": "webhook-session",
      "name": "Session Log Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-400, 160],
      "webhookId": "pos-session-log"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst now = $now.setZone('Asia/Manila');\nreturn [{\n  json: {\n    Type: body.type || 'staff',\n    Name: body.name || 'Unknown',\n    Token: body.token || '',\n    Action: body.action === 'logout' ? 'logout' : 'login',\n    Key: `session:${body.type || 'staff'}:${body.name || 'Unknown'}`,\n    Value: JSON.stringify({ token: body.token || '', loginAt: now.toFormat('yyyy-MM-dd HH:mm:ss') })\n  }\n}];"
      },
      "id": "format-session",
      "name": "Format Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-180, 160]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{$json.Action}}",
              "rightValue": "login",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-login",
      "name": "Is Login?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [40, 160]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "={{$json.Key}}",
        "value": "={{$json.Value}}",
        "expire": true,
        "ttl": 43200
      },
      "id": "redis-set",
      "name": "Redis: Save Session",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [260, 80],
      "credentials": { "redis": { "id": "REPLACE_WITH_YOUR_REDIS_CREDENTIAL_ID", "name": "Redis account" } }
    },
    {
      "parameters": {
        "operation": "delete",
        "key": "={{$json.Key}}"
      },
      "id": "redis-delete",
      "name": "Redis: Clear Session",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [260, 260],
      "credentials": { "redis": { "id": "REPLACE_WITH_YOUR_REDIS_CREDENTIAL_ID", "name": "Redis account" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true } }}",
        "options": {}
      },
      "id": "respond-session",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 160]
    }
  ],
  "connections": {
    "Session Log Webhook": { "main": [[{ "node": "Format Session", "type": "main", "index": 0 }]] },
    "Format Session": { "main": [[{ "node": "Is Login?", "type": "main", "index": 0 }]] },
    "Is Login?": {
      "main": [
        [{ "node": "Redis: Save Session", "type": "main", "index": 0 }],
        [{ "node": "Redis: Clear Session", "type": "main", "index": 0 }]
      ]
    },
    "Redis: Save Session": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] },
    "Redis: Clear Session": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
