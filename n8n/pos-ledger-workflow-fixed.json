        "operation": "append",
        "documentId": { "__rl": true, "value": "19GKbPSysyctCGaJPGq7Je6D2E9HncQLFWbXqzbrjdpU", "mode": "id" },
        "sheetName": { "__rl": true, "value": "0", "mode": "id" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "OrderNumber": "={{$json.orderNumber}}",
            "Day": "={{$json.day}}",
            "Date": "={{$json.date}}",
            "Time": "={{$json.time}}",
