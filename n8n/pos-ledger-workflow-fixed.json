        "responseMode": "responseNode",
        "options": { "allowedOrigins": "*" }
      },
      "id": "b4492c63-1634-407c-b637-808a18420622",
      "name": "POS Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-368, 272],
      "webhookId": "pos-order"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ Array.isArray($json.body.items) ? $json.body.items.length : 0 }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            },
            {
              "id": "cond2",
              "leftValue": "={{ $json.body.total }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b686b259-f45b-46a5-8ff2-58abf94aec9a",
      "name": "Validate Order",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-144, 272]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\n\nconst now = $now.setZone('Asia/Manila');\nconst items = Array.isArray(body.items) ? body.items : [];\nconst itemsSummary = items.map(i => `${i.name} x${i.qty}`).join(', ');\n\nreturn [{\n  json: {\n    orderNumber: body.orderNumber,\n    customerName: body.customerName || 'Guest',\n    date: now.toFormat('yyyy-MM-dd'),\n    day: now.toFormat('cccc'),\n    time: now.toFormat('hh:mm a'),\n    items: itemsSummary,\n    subtotal: body.subtotal,\n    discount: body.discountAmount,\n    tax: body.tax,\n    total: body.total,\n    cost: body.cost || 0,\n    profit: body.profit || 0,\n    paymentMethod: body.paymentMethod,\n    orderType: body.orderType,\n    note: body.note || ''\n  }\n}];"
      },
      "id": "a572b074-7c76-4b84-a918-8ea9879e8a9a",
      "name": "Format Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 192]
    },
