        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\n\nconst now = $now.setZone('Asia/Manila');\nconst items = Array.isArray(body.items) ? body.items : [];\nconst itemsSummary = items.map(i => `${i.name} x${i.qty}`).join(', ');\n\nreturn [{\n  json: {\n    OrderNumber: body.orderNumber,\n    Day: now.toFormat('cccc'),\n    Date: now.toFormat('yyyy-MM-dd'),\n    Time: now.toFormat('hh:mm a'),\n    Customer: body.customerName || 'Guest',\n    Items: itemsSummary,\n    Subtotal: body.subtotal,\n    Discount: body.discountAmount,\n    Tax: body.tax,\n    Total: body.total,\n    Cost: body.cost || 0,\n    Profit: body.profit || 0,\n    PaymentMethod: body.paymentMethod,\n    OrderType: body.orderType,\n    Note: body.note || '',\n    Staff: body.staffName || 'Unknown'\n  }\n}];"
      },
