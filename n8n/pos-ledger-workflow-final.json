{
  "name": "POS Ledger & CRM (Final)",
  "nodes": [
    {
      "parameters": {
        "content": "## BAGO I-ACTIVATE\n1. Document IDs na naka-fill in na (3 bagong sheets).\n2. Siguraduhin may Row 1 headers na ang 3 sheet mo (tingnan ang chat instructions).\n3. I-select ang tamang credential sa bawat Google Sheets + Slack node (dropdown lang, dapat naka-preselect na).\n4. Activate.",
        "height": 220,
        "width": 360
      },
      "id": "note-node",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-600, -80]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pos-order",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "*" }
      },
      "id": "webhook-order",
      "name": "POS Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-368, 272],
      "webhookId": "pos-order"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ Array.isArray($json.body.items) ? $json.body.items.length : 0 }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            },
            {
              "id": "cond2",
              "leftValue": "={{ $json.body.total }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate-order",
      "name": "Validate Order",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-144, 272]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\n\nconst now = $now.setZone('Asia/Manila');\nconst items = Array.isArray(body.items) ? body.items : [];\nconst itemsSummary = items.map(i => `${i.name} x${i.qty}`).join(', ');\n\nreturn [{\n  json: {\n    orderNumber: body.orderNumber,\n    customerName: body.customerName || 'Guest',\n    date: now.toFormat('yyyy-MM-dd'),\n    day: now.toFormat('cccc'),\n    time: now.toFormat('hh:mm a'),\n    items: itemsSummary,\n    subtotal: body.subtotal,\n    discount: body.discountAmount,\n    tax: body.tax,\n    total: body.total,\n    cost: body.cost || 0,\n    profit: body.profit || 0,\n    paymentMethod: body.paymentMethod,\n    orderType: body.orderType,\n    note: body.note || ''\n  }\n}];"
      },
      "id": "format-order",
      "name": "Format Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 192]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": { "__rl": true, "value": "1hphbw2OXPi2Mq0RVtauzbfG9YmfQvx8EBRFkzXmplC4", "mode": "id" },
        "sheetName": { "__rl": true, "value": "0", "mode": "id" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "OrderNumber": "={{$json.orderNumber}}",
            "Day": "={{$json.day}}",
            "Date": "={{$json.date}}",
            "Time": "={{$json.time}}",
            "Customer": "={{$json.customerName}}",
            "Items": "={{$json.items}}",
            "Subtotal": "={{$json.subtotal}}",
            "Discount": "={{$json.discount}}",
